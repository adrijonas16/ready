<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.25" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.305.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datos iniciales (catálogo, colegios y listas de ejemplo) que se cargan en una base nueva -->
    <EmbeddedResource Include="Infrastructure/Database/seed-catalogo.sql" LogicalName="seed-catalogo.sql" />
    <EmbeddedResource Include="Infrastructure/Database/seed-colegios-arequipa.sql" LogicalName="seed-colegios-arequipa.sql" />
    <EmbeddedResource Include="Infrastructure/Database/seed-contactos-colegios.sql" LogicalName="seed-contactos-colegios.sql" />
  </ItemGroup>

</Project>